# Production safety: orchestrator is fail-closed. Leave true until manual
# canary tests pass and the n8n workflow-ID dispatch map is wired.
GROWTHOS_PAUSED=true

# Stale-run watchdog: agent runs older than this are marked failed by 98.
GROWTHOS_RUN_TIMEOUT_MINUTES=45

# Dry-run mode: yellow/green consequential writers (publisher, citations)
# skip their external writes and log what WOULD have happened instead.
# Read-only intelligence agents are unaffected.
GROWTHOS_DRY_RUN=false
