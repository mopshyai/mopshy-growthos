    {
      "parameters": {
        "url": "https://api.openai.com/v1/responses",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gpt-5.6-sol', input: `Turn this REAL Mopshy work evidence into 3 founder-post drafts (one LinkedIn post, one X/Twitter post, one short newsletter blurb). Ground every claim ONLY in the evidence provided; never invent customer results, metrics, quotes, or client names. Voice: operator-to-operator, specific, no hype, no engagement bait. EVIDENCE: ${JSON.stringify($('Compile Evidence').first().json)}. Return ONLY JSON: {posts:[{platform:'linkedin'|'x'|'newsletter', hook, body, cta, evidence_refs:[string]}]}` }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "options": {
          "timeout": 240
        }
      },
      "id": "da3247cb-0925-5882-93d9-e765aa6e26b6",
      "name": "Founder Ideation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "const parseResp = (r) => { const text = r.output_text || (r.output || []).flatMap(o => o.content || []).find(c => c.type === 'output_text')?.text || ''; let d; try { d = JSON.parse(text); } catch (e) { const m = text.match(/\\{[\\s\\S]*\\}/); if (!m) throw new Error('Model did not return JSON'); d = JSON.parse(m[0]); } return d; };\nreturn [{ json: { posts: (parseResp(items[0].json).posts || []) } }];"
      },
      "id": "673d1c04-7547-5d60-b0b7-7f0a6c276563",
      "name": "Parse Founder Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst results = items.map(i => i.json);\nconst assets = [], tasks = [];\nlet adapted = 0;\nfor (const r of results) {\n  for (const p of (r.posts || [])) {\n    adapted++;\n    const today = new Date().toISOString().slice(0, 10);\n    assets.push({ content_type: 'founder_post', title: (p.hook || 'Founder post').slice(0, 120), slug: 'founder-' + today + '-' + String(p.platform || 'post') + '-' + adapted, status: 'draft', body: String(p.body || ''), research: { evidence_refs: p.evidence_refs || [], cta: p.cta || null }, metadata: { platform: p.platform, hook: p.hook, drafted_at: today } });\n  }\n}\nfor (const a of assets) tasks.push(mk('review_founder_post', 'P2', 'Review founder post: ' + a.title.slice(0, 80), 'Founder-grade draft generated from real Mopshy work evidence. Review for voice, accuracy, and approval before any posting.', { slug: a.slug, platform: a.metadata.platform, expected_impact: 'founder-led distribution' }, true));\nconst deduped = dedupeTitles(tasks, $('Get Open Founder Tasks').all().map(i => i.json));\nreturn [{ json: { asset_inserts: assets, tasks: deduped, summary: { posts_drafted: adapted, approval_tasks: deduped.length }, tasks_created: deduped.length } }];"
      },
