      "id": "12d368e2-629e-5353-8743-00e1931f5072",
      "name": "Get Recent Published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -40,
        -80
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const commits = $('Get Recent Commits').all().map(i => i.json).filter(c => c && c.sha)\n  .map(c => ({ sha: String(c.sha).slice(0, 8), message: (c.commit && c.commit.message || '').split('\\n')[0], date: c.commit && c.commit.author && c.commit.author.date }));\nconst published = $('Get Recent Published').all().map(i => i.json).filter(d => d && d.id)\n  .map(d => ({ slug: d.slug, title: d.title, published_at: d.published_at }));\nreturn [{ json: { commits, published, evidence_count: commits.length + published.length } }];"
      },
      "id": "92af032b-8821-5b23-a874-bb291e683581",
      "name": "Compile Evidence",
