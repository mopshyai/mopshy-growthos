        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gpt-5.6-sol',, tools: [{ type: 'web_search' }], input: `You are Mopshy's backlink intelligence analyst. Search the web for RECENT, REAL unlinked mentions of Mopshy (mopshy.com), an AI automation agency: discussions, articles, listicles, forum threads, social posts that mention Mopshy without linking to it. Only report results you actually found; never fabricate URLs. Return ONLY JSON: {opportunities:[{domain, url, opportunity_type:'unlinked_mention', rationale, relevance_score:0-100, authority_score:0-100}]}` }) }}",
