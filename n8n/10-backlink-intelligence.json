      ]
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/responses",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gpt-5.6-sol',, tools: [{ type: 'web_search' }], input: `You are Mopshy's backlink intelligence analyst. Find REAL resource pages, directories, 'best AI automation agencies' lists, n8n/Make/Zapier partner or agency directories, and guest-post pages where mopshy.com could plausibly earn a legitimate editorial link. No spam, no link farms, no paid-link schemes. Only report results you actually found. Return ONLY JSON: {opportunities:[{domain, url, opportunity_type:'resource_page'|'directory'|'guest_post', rationale, relevance_score:0-100, authority_score:0-100}]}` }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "options": {
          "timeout": 300
        }
      },
      "id": "de70132a-0399-5b7f-8446-392cfcc90547",
      "name": "Hunt Resource Pages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst parseResp = (r) => { const text = r.output_text || (r.output || []).flatMap(o => o.content || []).find(c => c.type === 'output_text')?.text || ''; let d; try { d = JSON.parse(text); } catch (e) { const m = text.match(/\\{[\\s\\S]*\\}/); if (!m) throw new Error('Model did not return JSON'); d = JSON.parse(m[0]); } return d; };\nconst existing = new Set($('Reduce Backlinks').first().json.existing.map(r => (r.url || '').replace(/\\/$/, '')));\nconst hunts = [['Hunt Unlinked Mentions', 'Hunt Resource Pages']];\nconst found = [];\nfor (const node of hunts.flat()) { try { const d = parseResp($(node).first().json); for (const o of (d.opportunities || [])) if (o && o.url) found.push(o); } catch (e) {}\n}\nconst seen = new Set(); const inserts = [];\nfor (const o of found) {\n  const u = String(o.url).replace(/\\/$/, '');\n  if (seen.has(u) || existing.has(u)) continue;\n  seen.add(u);\n  const rel = Number(o.relevance_score) || 50, auth = Number(o.authority_score) || 50;\n  inserts.push({ domain: o.domain || new URL(u).hostname, url: u, opportunity_type: o.opportunity_type || 'unlinked_mention', relevance_score: rel, authority_score: auth, total_score: Math.round((rel + auth) / 2), contact_data: { rationale: o.rationale || null }, status: 'new' });\n}\ninserts.sort((a, b) => b.total_score - a.total_score);\nconst top = inserts.slice(0, 25);\nconst tasks = top.filter(o => o.total_score >= 60).slice(0, 10).map(o => mk('backlink_opportunity', 'P3', 'Pursue backlink: ' + o.domain, o.opportunity_type.replace('_', ' ') + ' worth pursuing through the outreach system. ' + (o.contact_data.rationale || ''), { url: o.url, type: o.opportunity_type, total_score: o.total_score, expected_impact: 'referring domains' }, false));\nreturn [{ json: { backlink_inserts: top, tasks, summary: { opportunities_found: found.length, new_stored: top.length, tasks_created: tasks.length }, tasks_created: tasks.length } }];"
      },
