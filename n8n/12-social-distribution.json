    {
      "parameters": {
        "jsCode": "const published = $('Get Published Recent').all().map(i => i.json).filter(d => d && d.slug);\nconst existing = new Set($('Get Existing Social').all().map(i => i.json && i.json.metadata && i.json.metadata.source_slug).filter(Boolean));\nconst targets = published.filter(d => !existing.has(d.slug));\nreturn [{ json: { targets } }];"
      },
