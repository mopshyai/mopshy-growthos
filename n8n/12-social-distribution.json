    {
      "parameters": {
        "url": "https://api.openai.com/v1/responses",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gpt-5.6-sol', input: `Adapt this published Mopshy article into social posts. ARTICLE: ${JSON.stringify($json)}. Write 3 variants: a LinkedIn post (operator voice, concrete insight, 120-200 words, no hashtag stuffing), an X/Twitter post (under 280 characters), and a 2-3 sentence newsletter blurb. Ground everything in the article content; invent nothing. Return ONLY JSON: {posts:[{platform:'linkedin'|'x'|'newsletter', hook, body, cta}]}` }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "options": {
          "timeout": 240
        }
      },
      "id": "70fc11c7-0763-5905-8fc9-5940d1a60b60",
      "name": "Adapt Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "const parseResp = (r) => { const text = r.output_text || (r.output || []).flatMap(o => o.content || []).find(c => c.type === 'output_text')?.text || ''; let d; try { d = JSON.parse(text); } catch (e) { const m = text.match(/\\{[\\s\\S]*\\}/); if (!m) throw new Error('Model did not return JSON'); d = JSON.parse(m[0]); } return d; };\nreturn [{ json: { source_slug: $('Explode Targets').item.json.slug, posts: (parseResp(items[0].json).posts || []) } }];"
      },
      "id": "c991dac1-a4c7-5a82-aa00-cbd14c8ef693",
      "name": "Parse Social Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst results = items.map(i => i.json);\nconst assets = [], tasks = [];\nlet adapted = 0;\nfor (const r of results) {\n  if (!r || !r.source_slug) continue;\n  for (const p of (r.posts || [])) {\n    adapted++;\n    const today = new Date().toISOString().slice(0, 10);\n    assets.push({ content_type: 'social_post', title: (p.hook || 'Social post').slice(0, 120), slug: 'social-' + today + '-' + r.source_slug.slice(0, 40) + '-' + adapted, status: 'draft', body: String(p.body || ''), research: {}, metadata: { platform: p.platform, source_slug: r.source_slug, cta: p.cta || null, adapted_at: today } });\n  }\n}\nfor (const a of assets) tasks.push(mk('review_social_post', 'P2', 'Review social post: ' + a.title.slice(0, 80), 'Platform-adapted draft of a published Mopshy article. Review and approve before posting.', { slug: a.slug, platform: a.metadata.platform, source_slug: a.metadata.source_slug, expected_impact: 'distribution' }, true));\nconst deduped = dedupeTitles(tasks, $('Get Open Social Tasks').all().map(i => i.json));\nreturn [{ json: { asset_inserts: assets, tasks: deduped, summary: { posts_adapted: adapted, approval_tasks: deduped.length }, tasks_created: deduped.length } }];"
      },
