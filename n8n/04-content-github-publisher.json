    {
      "parameters": {
        "jsCode": "if (!items.length || !items[0].json.id) return [{ json: { no_draft: true } }]; const d=items[0].json; if (!d.fact_check_passed || Number(d.quality_score)<90 || Number(d.unsupported_claim_count)!==0 || d.primary_source_present!==true) return []; if (d.qa_report && Array.isArray(d.qa_report.outdated_claims) && d.qa_report.outdated_claims.length>0) throw new Error('Publisher blocked draft with outdated claims in QA report'); const allowedCategories=['AI News','Automation Playbook','Technical Guide','Tool Spotlight','Lead Generation','Sales','Operations','Enterprise AI','Fundamentals']; if (!allowedCategories.includes(String(d.category||''))) throw new Error('Publisher blocked category outside content-engine allowlist: ' + d.category); if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(String(d.slug||''))) throw new Error('Publisher blocked invalid slug'); if (!Array.isArray(d.body) || d.body.length < 3) throw new Error('Publisher blocked underspecified article body'); const sources=Array.isArray(d.sources)?d.sources.filter(s=>s&&s.url):[]; if(sources.length<3) throw new Error('Publisher requires at least 3 sources'); if(!sources.some(s=>s.primary===true)) throw new Error('Publisher requires at least one primary source'); const internal=Array.isArray(d.internal_links)?d.internal_links.filter(x=>x&&x.url&&String(x.url).startsWith('/')):[]; if(internal.length<3) throw new Error('Publisher requires at least 3 internal links'); return items;"
      },
