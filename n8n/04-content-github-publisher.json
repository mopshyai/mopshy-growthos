    {
      "parameters": {
        "jsCode": "const d=$('Final Safety Gate').item.json; const today=new Date().toISOString().slice(0,10); const internal=(Array.isArray(d.internal_links)?d.internal_links:[]).filter(x=>x&&x.url&&String(x.url).startsWith('/')).map(x=>({label:String(x.label||x.url),url:String(x.url)})); const sources=(Array.isArray(d.sources)?d.sources:[]).filter(s=>s&&s.url).map(s=>({url:String(s.url),publisher:s.publisher?String(s.publisher):undefined,title:s.title?String(s.title):undefined,publishedAt:s.publishedAt?String(s.publishedAt):undefined,claims:Array.isArray(s.claims)?s.claims.map(String):undefined,primary:typeof s.primary==='boolean'?s.primary:undefined})); const body=Array.isArray(d.body)?d.body.map(b=>({...b})):[]; const hasRelated=body.some(b=>b&&b.type==='links'&&String(b.title||'').toLowerCase().includes('related')); const hasSources=body.some(b=>b&&b.type==='links'&&String(b.title||'').toLowerCase().includes('source')); if(internal.length&&!hasRelated) body.push({type:'links',title:'Related on Mopshy',items:internal}); if(sources.length&&!hasSources) body.push({type:'links',title:'Sources',items:sources.map(s=>({label:s.title||s.publisher||s.url,url:s.url,source:s.publisher}))}); const article={schemaVersion:1,status:'published',slug:String(d.slug),category:String(d.category),title:String(d.title),excerpt:String(d.excerpt||''),readTime:String(d.read_time||d.readTime||'8 min read'),cover:String(d.cover||'/og-image.png'),publishedAt:today,updatedAt:today,metaTitle:String(d.meta_title||d.metaTitle||d.title),metaDescription:String(d.meta_description||d.metaDescription||d.excerpt||''),keywords:Array.isArray(d.keywords)?d.keywords.map(String):[],body,faqs:Array.isArray(d.faqs)?d.faqs:[],sources,internalLinks:internal}; if(article.metaDescription.length<50) throw new Error('Publisher blocked meta description under 50 characters'); if(article.keywords.length<1) throw new Error('Publisher blocked article without keywords'); const path=`src/content/blog/articles/${article.slug}.article.json`; const branch=`content/${article.slug}-${today}`; const json=JSON.stringify(article,null,2)+'\\n'; return [{json:{draft:d,article,branch,path,content_b64:Buffer.from(json,'utf8').toString('base64'),main_sha:$('Get Website Main SHA').item.json.object.sha}}];"
      },
