      "parameters": {
        "jsCode": "// Multi-path summary: real PR, reused PR (publisher retry safety), dry-run, or\n// nothing ready. Uses whichever branch actually executed.\nconst get = (n) => { try { return $(n).all(); } catch (e) { return null; } };\nconst recorded = get('Record PR');\nconst reused = get('Record Existing PR');\nconst dry = get('Compose Dry-Run Outcome');\nlet summary;\nif (recorded) summary = { prs_opened: recorded.length };\nelse if (reused) summary = { prs_opened: 0, prs_reused: reused.length, note: 'existing open PR for this draft was reused (retry-safe)' };\nelse if (dry) summary = { dry_run: true, would_publish: dry[0].json.would_publish };\nelse summary = { prs_opened: 0, no_ready_draft: true };\nreturn [{ json: { summary, tasks_created: 0 } }];"
