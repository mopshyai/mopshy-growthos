    {
      "parameters": {
        "jsCode": "const agents = $('Gather Agent Health').all().map(i => i.json).filter(a => a && a.slug);\nconst tasks = $('Gather Open Tasks').all().map(i => i.json).filter(t => t && t.task_type);\nconst runs = items.map(i => i.json).filter(r => r && r.status);\nconst byPrio = { P0: 0, P1: 0, P2: 0, P3: 0 };\ntasks.forEach(t => { byPrio[t.priority] = (byPrio[t.priority] || 0) + 1; });\nconst failedRuns = runs.filter(r => r.status === 'failed' || r.error).length;\nconst completedRuns = runs.filter(r => r.status === 'completed').length;\nconst tasksCreated = runs.reduce((s, r) => s + (r.tasks_created || 0), 0);\nconst hourBudget = (a) => a.schedule === 'hourly' ? 6 : a.schedule === 'daily' ? 36 : 180;\nconst stale = agents.filter(a => a.status === 'active' && a.schedule && a.schedule !== 'on-demand' && (!a.last_run_at || (Date.now() - new Date(a.last_run_at)) / 3600000 > hourBudget(a)));\nconst p1 = tasks.filter(t => t.priority === 'P1').slice(0, 5).map(t => t.title);\nconst lines = [];\nlines.push('GrowthOS daily brief — ' + new Date().toISOString().slice(0, 10));\nlines.push('Open tasks: ' + tasks.length + ' (P0: ' + byPrio.P0 + ', P1: ' + byPrio.P1 + ', P2: ' + byPrio.P2 + ', P3: ' + byPrio.P3 + ')');\nlines.push('Agent runs last 24h: ' + completedRuns + ' completed, ' + failedRuns + ' failed, ' + tasksCreated + ' tasks created');\nif (p1.length) lines.push('Top priorities: ' + p1.join(' | '));\nif (stale.length) lines.push('Stale agents (no run within schedule budget): ' + stale.map(a => a.slug).join(', '));\nconst brief = { brief_date: new Date().toISOString().slice(0, 10), executive_summary: lines.join('\\n'), priorities: p1, metrics: { open_tasks: tasks.length, by_priority: byPrio, runs_24h: { completed: completedRuns, failed: failedRuns }, tasks_created_24h: tasksCreated, stale_agents: stale.map(a => a.slug) } };\nreturn [{ json: { brief, telegram_message: lines.join('\\n'), summary: { open_tasks: tasks.length, p1_open: byPrio.P1, runs_24h_completed: completedRuns, runs_24h_failed: failedRuns, stale_agents: stale.length }, tasks_created: 0 } }];"
      },
