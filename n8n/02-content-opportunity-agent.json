    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/content_opportunities?select=topic,target_keyword&order=created_at.desc&limit=300' }}",
        "options": {},
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
