        }
      },
      "id": "get-existing",
      "name": "Get Existing Opportunities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -500,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gpt-5.6-sol', tools: [{ type: 'web_search' }], input: `You are Mopshy's Trend Scout and SEO opportunity analyst. Today is ${$('Run Config').item.json.run_date}. Research CURRENT web developments plus evergreen demand at the intersection of AI automation, AI agents, n8n/Make/Zapier, sales automation, lead generation, CRM automation, customer support, operations, product/AI implementation, OpenAI, Anthropic, Gemini, Microsoft, Meta, HubSpot, and Salesforce. Identify 15 content opportunities for mopshy.com, mixed approximately 65% buyer-intent/evergreen commercial (n8n + workflow automation, lead response + AI receptionist, CRM/RevOps automation, AI agents for operations/support, industry-specific automation for professional services, healthcare services, SaaS, e-commerce, logistics, home services, insurance, legal, dental, real estate), 20% original evidence/frameworks/implementation insight, and 15% meaningful timely AI developments. Every opportunity should ideally support a money page. Mopshy already covers these topics/keywords, so do not repeat them unless the angle is genuinely new: ${$('Get Existing Opportunities').all().map(i => i.json.target_keyword || i.json.topic).filter(Boolean).slice(0, 100).join('; ')}. Favor user questions with real search or buyer intent and fresh developments where Mopshy can add a practical implementation viewpoint. Do not select gossip, weak rumors, or topics unrelated to Mopshy's services. Score each opportunity using: topical relevance 20, search intent 15, trend acceleration 15, commercial relevance 15, original insight availability 15, competition opportunity 10, AI citation potential 10. Return ONLY valid JSON with shape { candidates: [{topic, angle, source_type, target_keyword, search_intent_label, opportunity_score, topical_relevance, search_intent, trend_acceleration, commercial_relevance, original_insight, competition_opportunity, ai_citation_potential, cannibalization_risk, recommended_action, rationale, source_urls:[url]}] }. recommended_action must be publish, research, backlog, refresh, or ignore. Scores are 0-100 overall and component scores 0-100; cannibalization_risk is 0-1 where 0.65 or higher means the topic duplicates existing Mopshy coverage. Use refresh if the likely intent overlaps an existing general Mopshy guide.` }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "discover",
      "name": "Research + Score Opportunities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = items[0].json;\nconst text = r.output_text || r.output?.flatMap(o => o.content || []).find(c => c.type === 'output_text')?.text || '';\nlet parsed;\ntry { parsed = JSON.parse(text); } catch (e) { const m = text.match(/\\{[\\s\\S]*\\}/); if (!m) throw new Error('Opportunity agent did not return JSON'); parsed = JSON.parse(m[0]); }\nconst rows = Array.isArray(parsed.candidates) ? parsed.candidates : [];\nreturn rows.map(c => ({ json: { ...c, source_urls: Array.isArray(c.source_urls) ? c.source_urls : [], metadata: { discovered_at: new Date().toISOString(), model: r.model || null } } }));"
      },
      "id": "parse",
      "name": "Parse Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const norm = (s) => String(s || '').toLowerCase().trim();\nconst existing = $('Get Existing Opportunities').all().map(i => i.json);\nconst seenTopics = new Set(existing.map(r => norm(r.topic)));\nconst seenKeywords = new Set(existing.map(r => norm(r.target_keyword)).filter(Boolean));\nconst candidates = $('Parse Candidates').all().map(i => i.json);\nconst fresh = candidates.filter(c => !seenTopics.has(norm(c.topic)) && !(c.target_keyword && seenKeywords.has(norm(c.target_keyword))));\nreturn [{ json: { candidates: fresh } }];"
      },
      "id": "dedupe",
      "name": "Filter Existing Topics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/content_opportunities' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ topic: $json.topic, angle: $json.angle, source_type: $json.source_type, status: 'discovered', opportunity_score: $json.opportunity_score, topical_relevance: $json.topical_relevance, search_intent: $json.search_intent, trend_acceleration: $json.trend_acceleration, commercial_relevance: $json.commercial_relevance, original_insight: $json.original_insight, competition_opportunity: $json.competition_opportunity, ai_citation_potential: $json.ai_citation_potential, cannibalization_risk: $json.cannibalization_risk, recommended_action: $json.recommended_action, target_keyword: $json.target_keyword, search_intent_label: $json.search_intent_label, rationale: $json.rationale, source_urls: $json.source_urls, metadata: $json.metadata }) }}",
        "options": {}
      },
