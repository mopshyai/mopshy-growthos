    {
      "parameters": {
        "jsCode": "const get = (n) => { try { return $(n).all(); } catch (e) { return null; } };\nconst stored = get('Store Opportunities');\nconst planned = get('Explode Candidates');\nreturn [{ json: { summary: { candidates_generated: planned ? planned.length : 0, candidates_stored: stored ? stored.length : 0 }, tasks_created: 0 } }];"
      },
