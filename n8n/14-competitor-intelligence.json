    {
      "parameters": {
        "jsCode": "const parseResp = (r) => { const text = r.output_text || (r.output || []).flatMap(o => o.content || []).find(c => c.type === 'output_text')?.text || ''; let d; try { d = JSON.parse(text); } catch (e) { const m = text.match(/\\{[\\s\\S]*\\}/); if (!m) throw new Error('Model did not return JSON'); d = JSON.parse(m[0]); } return d; };\nconst d = parseResp(items[0].json);\nreturn (d.events || []).map(ev => ({ json: { competitor_id: $('Explode Competitors').item.json.id, competitor_name: $('Explode Competitors').item.json.name, event_type: ev.event_type || 'update', summary: ev.summary, source_url: ev.source_url || null, impact_score: Number(ev.impact_score) || 0 } }));"
      },
      "id": "98a6f37e-790a-5608-865a-4ba11c69dfb7",
      "name": "Parse Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst results = items.map(i => i.json).filter(r => r && r.competitor_id);\nconst tasks = results.filter(r => r.impact_score >= 60).map(r => mk('competitor_move', 'P2', 'Competitor move: ' + r.competitor_name, r.summary + (r.source_url ? ' Source: ' + r.source_url : ''), { competitor: r.competitor_name, impact_score: r.impact_score, source_url: r.source_url, expected_impact: 'strategic response' }, false));\nconst deduped = dedupeTitles(tasks, $('Get Open Competitor Tasks').all().map(i => i.json));\nreturn [{ json: { event_inserts: results, tasks: deduped.slice(0, 10), summary: { competitors_scanned: $('Reduce Competitors').first().json.competitors.length, events_found: results.length, high_impact: results.filter(r => r.impact_score >= 60).length }, tasks_created: deduped.length } }];"
      },
