    {
      "parameters": {
        "jsCode": "// Idempotency: drop events whose (competitor_id, source_url) was already\n// recorded, so a retried run cannot double-log the same competitor event.\nconst seen = new Set(items.map(i => i.json && (i.json.competitor_id + '|' + i.json.source_url)).filter(s => !s.endsWith('|') && !s.startsWith('|')));\nconst build = $('Build Run Summary').first().json;\nconst events = (build.event_inserts || []).filter(e => !seen.has(e.competitor_id + '|' + e.source_url));\nreturn [{ json: { event_inserts: events, tasks: build.tasks || [] } }];"
      },
