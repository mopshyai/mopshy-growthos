        "body": "={{ JSON.stringify({ model: 'gpt-5.6-sol', tools: [{ type: 'web_search' }], input: `You are Mopshy's competitive intelligence analyst. Research ${$json.name} (${$json.domain}) for changes in the last 14 days: product announcements, pricing or packaging changes, new content or SEO plays, partnerships, funding. Use CURRENT web search. Only report what you actually find; never speculate. Return ONLY JSON: {events:[{event_type, summary, source_url, impact_score: 0-100}]}. If nothing notable, return an empty events array.` }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "options": {
          "timeout": 240
        }
      },
      "id": "b3f56c0b-9e63-5b78-aba7-9097e2931037",
      "name": "Research Competitor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        -200
