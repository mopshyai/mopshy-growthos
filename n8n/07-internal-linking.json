      },
      "id": "8531925b-d1e5-52f7-bb5e-0198ed7107ad",
      "name": "Get Open Link Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        -80
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst pages = $('Reduce To One').first().json.pages;\nconst now = new Date().toISOString();\nconst page_upserts = pages.map(p => ({ url: p.url, title: p.title || null, last_crawled_at: now, metrics: { internal_link_count: p.internal_count || 0, internal_links: (p.internal_links || []).slice(0, 50), crawl_error: p.failed ? (p.status || 'error') : null } }));\nconst linkTargets = new Set();\npages.forEach(p => (p.internal_links || []).forEach(u => linkTargets.add(u)));\nconst crawled = new Set(pages.map(p => p.url));\nconst sitemap = $('Parse Sitemap').first().json.sitemap_urls;\nconst tasks = [];\nfor (const u of sitemap) {\n  if (u.replace(/\\/$/, '') === ($('Run Config').first().json.site_url || '').replace(/\\/$/, '')) continue;\n  if (!linkTargets.has(u.replace(/\\/$/, '')) && crawled.has(u)) {\n    tasks.push(mk('internal_orphan', 'P3', 'Internal linking: ' + u + ' is an orphan', 'Page is in the sitemap and was crawled, but no crawled page links to it (sample of 25 pages). Add internal links from related pages.', { url: u, expected_impact: 'crawl depth and equity flow' }, true));\n  }\n}\nfor (const p of pages) {\n  if (p.failed) tasks.push(mk('internal_broken_page', 'P1', 'Unreachable page: ' + p.url, 'Page fetch failed during internal linking audit (status ' + (p.status || 'error') + '). Fix availability or remove/redirect.', { url: p.url, status: p.status, expected_impact: 'protect rankings and UX' }, true));\n  else if ((p.internal_count || 0) < 2) tasks.push(mk('internal_link_fix', 'P3', 'Weakly linked page: ' + p.url, 'Page contains fewer than 2 internal links. Add contextual links to related guides and commercial pages.', { url: p.url, internal_count: p.internal_count, expected_impact: 'stronger information architecture' }, true));\n}\nconst deduped = dedupeTitles(tasks, $('Get Open Link Tasks').all().map(i => i.json));\nreturn [{ json: { page_upserts, tasks: deduped.slice(0, 25), summary: { pages_crawled: pages.length, crawl_failures: pages.filter(p => p.failed).length, orphans_found: deduped.filter(t => t.task_type === 'internal_orphan').length, weak_pages: deduped.filter(t => t.task_type === 'internal_link_fix').length, tasks_created: deduped.length }, tasks_created: deduped.length } }];"
      },
