      "id": "c77418a9-b92f-511a-8751-8b138741f30e",
      "name": "Get Known Pages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        -80
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const siteUrl = $('Run Config').first().json.site_url || 'https://mopshy.com/';\nconst sitemap = $('Parse Sitemap').first().json.sitemap_urls;\nconst known = new Map($('Get Known Pages').all().map(i => [i.json.url, i.json.last_crawled_at]));\nconst batch = sitemap.map(u => ({ url: u, last: known.get(u) || null }))\n  .sort((a, b) => new Date(a.last || 0) - new Date(b.last || 0)).slice(0, 25);\nreturn batch.map(b => ({ json: b }));"
      },
      "id": "1860dba4-a165-58bd-a55d-83fa5748fc91",
      "name": "Pick Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -80
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "MopshyGrowthOS/1.0 (internal audit)"
            }
          ]
        },
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "7b6e5c5c-3178-5bdb-bfed-497d2a2e7ee4",
      "name": "Fetch Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        -80
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const siteUrl = $('Run Config').first().json.site_url || 'https://mopshy.com/';\nlet host = 'mopshy.com'; try { host = new URL(siteUrl).hostname; } catch (e) {}\nconst batch = $('Pick Batch').all().map(i => i.json);\nconst out = [];\nfor (let i = 0; i < batch.length; i++) {\n  const r = (items[i] && items[i].json) || {};\n  const url = batch[i].url;\n  if (r.error) { out.push({ json: { url, failed: true, status: r.statusCode || null, internal_links: [], internal_count: 0 } }); continue; }\n  const html = String(r.data || '');\n  const hrefs = [...html.matchAll(/<a\\s[^>]*href=[\"']([^\"'#]+)[\"']/gi)].map(m => m[1]);\n  const norm = (h) => { try { const u = new URL(h, url); if (u.hostname !== host && u.hostname !== 'www.' + host) return null; u.hash = ''; return u.origin + u.pathname; } catch (e) { return null; } };\n  const internal = [...new Set(hrefs.map(norm).filter(Boolean))];\n  const titleM = html.match(/<title[^>]*>([^<]*)<\\/title>/i);\n  out.push({ json: { url, failed: false, title: titleM ? titleM[1].trim().slice(0, 200) : null, internal_links: internal, internal_count: internal.length } });\n}\nreturn out;"
      },
      "id": "26b9fd71-279d-5ae6-bdf1-f2b4e372f890",
      "name": "Parse Link Graph",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        -80
