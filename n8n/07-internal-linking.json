      "typeVersion": 4.2,
      "position": [
        -280,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = items[0].json.data || '';\nconst locs = [...raw.matchAll(/<loc>\\s*([^<\\s]+)\\s*<\\/loc>/gi)].map(m => m[1]);\nconst sitemap_urls = [...new Set(locs)].slice(0, 500);\nif (!sitemap_urls.length) { throw new Error('Sitemap returned no URLs.'); }\nreturn [{ json: { sitemap_urls } }];"
      },
      "id": "fd8b6ae9-7a03-585f-9d09-b17055ca015a",
      "name": "Parse Sitemap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        -80
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/pages?select=url,last_crawled_at&limit=500' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
