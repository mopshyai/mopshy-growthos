      "id": "d4906a38-5d7c-54b1-9dd5-2118d7334440",
      "name": "Audit Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        -80
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst batch = $('Pick Batch').all().map(i => i.json);\nconst out = [];\nfor (let i = 0; i < batch.length; i++) {\n  const r = (items[i] && items[i].json) || {};\n  const url = batch[i].url;\n  const html = String((r && r.data) || '');\n  const status = r.error ? (r.statusCode || 0) : (r.statusCode || 200);\n  const issues = [];\n  if (status !== 200) issues.push({ severity: 'P1', code: 'unreachable', detail: 'HTTP ' + status });\n  else {\n    const noindex = /<meta[^>]+name=[\"']robots[\"'][^>]+noindex/i.test(html);\n    if (noindex) issues.push({ severity: 'P1', code: 'noindex', detail: 'page is marked noindex' });\n    const titleM = html.match(/<title[^>]*>([^<]*)<\\/title>/i);\n    const title = titleM ? titleM[1].trim() : '';\n    if (!title) issues.push({ severity: 'P2', code: 'missing_title', detail: 'no title tag' });\n    else if (title.length > 65 || title.length < 20) issues.push({ severity: 'P3', code: 'title_length', detail: 'title is ' + title.length + ' chars' });\n    const descM = html.match(/<meta[^>]+name=[\"']description[\"'][^>]+content=[\"']([^\"']*)[\"']/i);\n    const desc = descM ? descM[1] : '';\n    if (!desc) issues.push({ severity: 'P2', code: 'missing_description', detail: 'no meta description' });\n    else if (desc.length > 160) issues.push({ severity: 'P3', code: 'description_length', detail: 'description is ' + desc.length + ' chars' });\n    if (!/<link[^>]+rel=[\"']canonical[\"']/i.test(html)) issues.push({ severity: 'P3', code: 'missing_canonical', detail: 'no canonical tag' });\n    const h1 = (html.match(/<h1[\\s>]/gi) || []).length;\n    if (h1 !== 1) issues.push({ severity: 'P3', code: 'h1_count', detail: h1 + ' h1 tags' });\n  }\n  out.push({ json: { url, status, indexable: status === 200 && !/<meta[^>]+name=[\"']robots[\"'][^>]+noindex/i.test(html), issues, page_row: { url, status_code: status, indexable: status === 200 && !/<meta[^>]+name=[\"']robots[\"'][^>]+noindex/i.test(html), last_crawled_at: new Date().toISOString(), metrics: { title_length: (html.match(/<title[^>]*>([^<]*)<\\/title>/i) || ['', ''])[1].trim().length, has_canonical: /<link[^>]+rel=[\"']canonical[\"']/i.test(html) } } } });\n}\nreturn out;"
      },
