    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst audits = $('Reduce To One').first().json.audits;\nconst tasks = [];\nfor (const a of audits) {\n  for (const iss of a.issues) {\n    tasks.push(mk('technical_seo_issue', iss.severity, 'Technical SEO [' + iss.code + ']: ' + a.url, iss.detail + '. Detected during technical SEO audit.', { url: a.url, issue: iss.code, detail: iss.detail, expected_impact: 'search health' }, true));\n  }\n}\nconst deduped = dedupeTitles(tasks, $('Get Open Tech Tasks').all().map(i => i.json));\nreturn [{ json: { page_upserts: audits.map(a => a.page_row), tasks: deduped.slice(0, 30), summary: { pages_audited: audits.length, indexable: audits.filter(a => a.indexable).length, issues_found: deduped.length, p1_issues: deduped.filter(t => t.priority === 'P1').length }, tasks_created: deduped.length } }];"
      },
