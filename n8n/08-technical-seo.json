      "id": "c77418a9-b92f-511a-8751-8b138741f30e",
      "name": "Get Known Pages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        -80
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const siteUrl = $('Run Config').first().json.site_url || 'https://mopshy.com/';\nconst sitemap = $('Parse Sitemap').first().json.sitemap_urls;\nconst known = new Map($('Get Known Pages').all().map(i => [i.json.url, i.json.last_crawled_at]));\nconst batch = sitemap.map(u => ({ url: u, last: known.get(u) || null }))\n  .sort((a, b) => new Date(a.last || 0) - new Date(b.last || 0)).slice(0, 20);\nreturn batch.map(b => ({ json: b }));"
      },
      "id": "1860dba4-a165-58bd-a55d-83fa5748fc91",
