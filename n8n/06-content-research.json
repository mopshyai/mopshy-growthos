        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gpt-5.6-sol', tools: [{ type: 'web_search' }], input: `You are Mopshy's research analyst. Build an evidence-backed research packet for this content opportunity. OPPORTUNITY: ${JSON.stringify($json)}. Research CURRENT web sources: verify the topic is still accurate, gather at least 3 credible sources (at least 1 primary for changing claims), extract key facts with the exact source that supports each, identify what is genuinely new, and define the practical Mopshy point of view (implementation architecture, decision framework, teardown, or trade-off analysis). Never invent facts, statistics, pricing, or quotes. If evidence is too thin or the topic is stale, reject it. Return ONLY JSON: {verdict:'approve'|'reject', confidence:number, reason:string, research_packet:{summary, key_facts:[{claim, source_url}], sources:[{url, publisher, title, primary:boolean}], freshness_note, pov_angle, outline:[{heading, notes}]}}` }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "options": {
          "timeout": 300
        }
      },
      "id": "e3f4e974-b845-501a-bbbb-512f251d891f",
      "name": "Deep Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "const parseResp = (r) => { const text = r.output_text || (r.output || []).flatMap(o => o.content || []).find(c => c.type === 'output_text')?.text || ''; let d; try { d = JSON.parse(text); } catch (e) { const m = text.match(/\\{[\\s\\S]*\\}/); if (!m) throw new Error('Model did not return JSON'); d = JSON.parse(m[0]); } return d; };\nreturn items.map(it => { const d = parseResp(it.json); return { json: { opportunity_id: $('Explode Work').item.json.id, topic: $('Explode Work').item.json.topic, verdict: d.verdict, confidence: d.confidence, reason: d.reason, packet: d.research_packet || null } }; });"
      },
      "id": "22e2aca7-ff0d-5fe5-bffe-cccc500f1457",
      "name": "Parse Research",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst results = items.map(i => i.json).filter(r => r.opportunity_id);\nconst updates = []; let approved = 0, rejected = 0;\nfor (const r of results) {\n  if (r.verdict === 'approve' && r.packet) { approved++; updates.push({ id: r.opportunity_id, patch: { status: 'approved', recommended_action: 'publish', metadata: { researched_at: new Date().toISOString(), model: 'gpt-5.6-sol', research_packet: r.packet } } }); }\n  else { rejected++; updates.push({ id: r.opportunity_id, patch: { recommended_action: 'backlog', metadata: { researched_at: new Date().toISOString(), reject_reason: r.reason || 'insufficient evidence' } } }); }\n}\nreturn [{ json: { updates, summary: { researched: results.length, approved, rejected }, tasks_created: 0 } }];"
      },
      "id": "8e00cded-477e-5032-9f46-398527a8af3c",
