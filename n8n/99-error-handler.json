        "url": "={{ $env.SUPABASE_URL + '/rest/v1/agent_runs?agent_id=eq.' + $('Get Agent By Slug').first().json.id + '&status=eq.running&order=started_at.desc&limit=1&select=id,agent_id,started_at' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
