      "parameters": {
        "jsCode": "const e = $json;\nconst execution = e.execution || {};\nconst workflow = e.workflow || {};\nconst triggerError = e.trigger && e.trigger.error ? e.trigger.error : (execution.error || null);\nreturn [{ json: {\n  workflow_name: workflow.name || 'unknown-workflow',\n  workflow_id: workflow.id || null,\n  execution_id: execution.id || null,\n  execution_url: execution.url || null,\n  error_message: (triggerError && triggerError.message) || e.message || 'Unknown n8n workflow error',\n  error_stack: (triggerError && triggerError.stack) || e.stack || null,\n  occurred_at: new Date().toISOString()\n} }];"
      },
      "id": "99-normalize-error",
      "name": "Normalize Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1320,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/workflow_runtime_map?workflow_name=eq.' + encodeURIComponent('\"' + $('Normalize Error').first().json.workflow_name + '\"') + '&select=workflow_id,workflow_name,agent_slug&limit=1' }}",
        "sendHeaders": false
      },
