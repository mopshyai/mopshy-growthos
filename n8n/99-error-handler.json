            }
          ]
        }
      },
      "id": "99-find-running-run",
      "name": "Find Running Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -600,
        -120
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Conservative matching: only the NEWEST running run for the resolved agent,\n// and only within a 6-hour recency boundary. Anything else is logged without\n// mutating an unrelated run.\nconst RECENCY_MS = 6 * 3600 * 1000;\nconst err = $('Normalize Error').first().json;\nlet mapRow = null; try { mapRow = $('Resolve Agent').first().json; } catch (e) {}\nlet agent = null; try { agent = $('Get Agent By Slug').first().json; } catch (e) {}\nlet run = null; try { run = $('Find Running Run').first().json; } catch (e) {}\nconst hasAgent = Boolean(agent && agent.id);\nlet matched = null;\nif (hasAgent && run && run.id && run.started_at) {\n  const age = Date.now() - new Date(run.started_at).getTime();\n  if (age >= 0 && age <= RECENCY_MS) matched = { id: run.id, started_at: run.started_at };\n}\nconst resolution = matched ? 'run_marked_failed'\n  : hasAgent ? 'no_trustworthy_running_run'\n  : (mapRow && mapRow.workflow_name && !mapRow.agent_slug) ? 'infrastructure_workflow'\n  : 'unmapped_workflow';\nreturn [{ json: {\n  err,\n  workflow_name: mapRow && mapRow.workflow_name ? mapRow.workflow_name : err.workflow_name,\n  agent: hasAgent ? { id: agent.id, slug: agent.slug, name: agent.name } : null,\n  matched_run: matched,\n  resolution\n} }];"
      },
      "id": "99-build-resolution",
      "name": "Build Resolution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -360,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
