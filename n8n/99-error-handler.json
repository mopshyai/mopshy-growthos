    {
      "parameters": {
        "jsCode": "const r = $('Build Resolution').first().json;\nreturn [{ json: {\n  event_type: 'agent_run_failed',\n  severity: 'critical',\n  source: r.agent ? r.agent.slug : (r.resolution === 'infrastructure_workflow' ? 'infrastructure' : 'unmapped'),\n  payload: {\n    workflow_name: r.err.workflow_name,\n    workflow_id: r.err.workflow_id,\n    execution_id: r.err.execution_id,\n    execution_url: r.err.execution_url,\n    error_message: r.err.error_message,\n    error_stack: r.err.error_stack,\n    occurred_at: r.err.occurred_at,\n    resolution: r.resolution,\n    matched_agent: r.agent ? r.agent.slug : null,\n    matched_run_id: r.matched_run ? r.matched_run.id : null\n  }\n} }];"
      },
