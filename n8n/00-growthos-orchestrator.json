            },
            {
              "id": "dispatch-note",
              "name": "dispatch_note",
              "value": "Connect this item to an Execute Workflow node mapped by agent slug after the individual agent workflows are imported.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "dispatch-contract",
      "name": "Dispatch Contract",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        400,
        0
      ]
    }
  ],
