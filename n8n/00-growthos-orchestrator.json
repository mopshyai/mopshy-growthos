{
  "name": "00 - GrowthOS Orchestrator",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -760,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "run-id",
              "name": "orchestrator_run_id",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "source",
              "name": "source",
              "value": "growthos-orchestrator",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "run-context",
      "name": "Create Run Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -540,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ ($env.GROWTHOS_PAUSED || 'true').toString().toLowerCase() }}",
              "rightValue": "false",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "global-pause-gate",
      "name": "GrowthOS Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -320,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/agents?status=eq.active&select=id,name,slug,autonomy,schedule,last_run_at,next_run_at' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "get-active-agents",
      "name": "Get Active Agents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -80,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst rows = items.flatMap(item => Array.isArray(item.json) ? item.json : [item.json]);\n\nfunction due(agent) {\n  if (agent.next_run_at) return new Date(agent.next_run_at) <= now;\n  if (!agent.last_run_at) return true;\n  const last = new Date(agent.last_run_at);\n  const ageMinutes = (now - last) / 60000;\n  switch (agent.schedule) {\n    case 'hourly': return ageMinutes >= 60;\n    case 'daily': return ageMinutes >= 1440;\n    case 'weekly': return ageMinutes >= 10080;\n    case 'on-demand': return false;\n    default: return false;\n  }\n}\n\nreturn rows.filter(due).map(agent => ({ json: { ...agent, dispatch_requested_at: now.toISOString() } }));"
      },
      "id": "filter-due-agents",
      "name": "Filter Due Agents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Dispatch preparation. Only agents whose n8n_workflow_id has been wired\n// (post-import step in docs/PRODUCTION_ACTIVATION.md) are dispatched; due\n// agents without a wired ID are reported in the orchestrator event instead of\n// silently disappearing. Unknown slugs fail via the Execute Workflow node's\n// own error path, which routes to the 99 error handler.\nconst due = items.flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(a => a && a.slug);\nconst ctx = $('Create Run Context').first().json;\nconst wired = due.filter(a => a.n8n_workflow_id).map(a => ({\n  agent_slug: a.slug,\n  agent_id: a.id,\n  n8n_workflow_id: a.n8n_workflow_id,\n  orchestrator_run_id: ctx.orchestrator_run_id,\n  dispatch_requested_at: new Date().toISOString()\n}));\nconst unwired = due.filter(a => !a.n8n_workflow_id).map(a => a.slug);\nreturn [{ json: { wired, unwired, dispatch_count: wired.length, any: wired.length + unwired.length } }];"
      },
      "id": "00-summarize",
      "name": "Summarize Dispatch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.any }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "00-has-work",
      "name": "Has Dispatch Work?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $json.wired.map(a => ({ json: a }));"
      },
      "id": "00-explode",
      "name": "Explode Wired Agents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -120
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "={{ $json.n8n_workflow_id }}",
          "mode": "id"
        },
        "options": {}
      },
      "id": "00-dispatch",
      "name": "Dispatch To Agent",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1140,
        -120
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/system_events' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ event_type: 'orchestrator_dispatch', severity: 'info', source: 'orchestrator', payload: { dispatch_count: $json.dispatch_count, dispatched: $json.wired.map(a => a.agent_slug), unwired_due_agents: $json.unwired, orchestrator_run_id: $json.wired[0] ? $json.wired[0].orchestrator_run_id : null } }) }}"
      },
      "id": "00-log",
      "name": "Log Orchestrator Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        120
      ],
      "onError": "continueRegularOutput"
    }
  ],
