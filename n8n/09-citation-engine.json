    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst dirs = $('Reduce Directories').first().json.dirs;\nconst cits = $('Get Citations').all().map(i => i.json).filter(x => x && x.directory_id);\nconst byDir = new Map(cits.map(x => [x.directory_id, x]));\nconst now = Date.now();\nconst openTitles = new Set($('Get Open Citation Tasks').all().map(i => i.json.title));\nconst inserts = [], tasks = [];\nfor (const d of dirs) {\n  const cit = byDir.get(d.id);\n  const stale = !cit || !cit.last_checked_at || (now - new Date(cit.last_checked_at)) > 30 * 86400000;\n  if (!cit) inserts.push({ directory_id: d.id, status: 'pending_submission', profile_data: { company: 'Mopshy', website: 'https://mopshy.com', description: 'Mopshy builds AI automation systems for business operations.', notes: 'Complete NAP (name, address, phone) fields manually at submission.' } });\n  const title = 'Submit Mopshy to ' + d.name;\n  if (stale && !openTitles.has(title)) tasks.push(mk('citation_submission', 'P2', title, 'Prepare and submit or verify the Mopshy listing on ' + d.name + ' (' + (d.submission_url || d.domain) + '). Authority ' + d.authority_score + '/100, relevance ' + d.relevance_score + '/100.', { directory: d.name, submission_url: d.submission_url, expected_impact: 'citation equity and brand trust' }, true));\n}\nreturn [{ json: { citation_inserts: inserts, tasks: tasks.slice(0, 10), summary: { directories_tracked: dirs.length, new_citations: inserts.length, approval_tasks: tasks.length }, tasks_created: tasks.length } }];"
      },
