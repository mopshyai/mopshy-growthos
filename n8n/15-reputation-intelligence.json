    {
      "parameters": {
        "url": "https://api.openai.com/v1/responses",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gpt-5.6-sol', tools: [{ type: 'web_search' }], input: `You are Mopshy's reputation monitor. Search the web for recent mentions, reviews, discussions, or complaints about Mopshy (mopshy.com), an AI automation agency. Check review sites, social platforms, directories, forums, and news. Only include REAL results you actually found; never fabricate. If nothing new exists, return an empty list. Return ONLY JSON: {mentions:[{source, url, mention_text, sentiment:'positive'|'neutral'|'negative', linked:boolean, requires_response:boolean, opportunity:boolean}]}` }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "options": {
          "timeout": 180
        }
      },
      "id": "0ce74dfb-9b04-5fd3-a248-0ec36ba0b332",
      "name": "Watch Mentions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const parseResp = (r) => { const text = r.output_text || (r.output || []).flatMap(o => o.content || []).find(c => c.type === 'output_text')?.text || ''; let d; try { d = JSON.parse(text); } catch (e) { const m = text.match(/\\{[\\s\\S]*\\}/); if (!m) throw new Error('Model did not return JSON'); d = JSON.parse(m[0]); } return d; };\nconst d = parseResp(items[0].json);\nreturn (d.mentions || []).map(m => ({ json: m }));"
      },
      "id": "9678b206-cd44-5084-97f3-a4bc5bf71d25",
      "name": "Parse Mentions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst existing = new Set($('Reduce Mentions').first().json.existing);\nconst results = items.map(i => i.json).filter(m => m && m.url);\nconst inserts = []; const tasks = [];\nfor (const m of results) {\n  if (existing.has(m.url)) continue;\n  inserts.push({ source: m.source || new URL(m.url).hostname, url: m.url, mention_text: m.mention_text || null, sentiment: m.sentiment || 'neutral', linked: !!m.linked, requires_response: !!m.requires_response, opportunity: !!m.opportunity });\n  if (m.sentiment === 'negative' || m.requires_response) tasks.push(mk('reputation_response', 'P1', 'Respond to mention: ' + (m.source || m.url), (m.mention_text || 'New mention') + ' — sentiment ' + m.sentiment + '. ' + m.url, { url: m.url, sentiment: m.sentiment, expected_impact: 'protect reputation' }, false));\n  else if (m.opportunity) tasks.push(mk('reputation_response', 'P2', 'Opportunity mention: ' + (m.source || m.url), (m.mention_text || 'Mention') + ' — potential engagement or link opportunity. ' + m.url, { url: m.url, sentiment: m.sentiment, expected_impact: 'earn mention or link' }, false));\n}\nconst deduped = dedupeTitles(tasks, $('Get Open Reputation Tasks').all().map(i => i.json));\nreturn [{ json: { mention_inserts: inserts, tasks: deduped.slice(0, 10), summary: { mentions_found: results.length, new_stored: inserts.length, negative: inserts.filter(x => x.sentiment === 'negative').length, needs_response: inserts.filter(x => x.requires_response).length }, tasks_created: deduped.length } }];"
      },
