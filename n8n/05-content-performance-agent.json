    {
      "parameters": {
        "jsCode": "const published = $('Get Published Drafts').all().map(i => i.json).filter(d => d && d.id && d.published_at);\nconst capturedItems = items.flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(s => s && s.draft_id);\nconst captured = new Set(capturedItems.map(s => s.draft_id + '|' + s.window_days));\nconst windows = [];\nfor (const d of published) {\n  const pub = new Date(d.published_at);\n  for (const w of [7, 14, 30]) {\n    const end = new Date(pub); end.setUTCDate(end.getUTCDate() + w);\n    if (end > new Date()) continue;\n    if (captured.has(d.id + '|' + w)) continue;\n    windows.push({ draft_id: d.id, slug: d.slug, url: 'https://mopshy.com/blog/' + d.slug, window_days: w, start_date: pub.toISOString().slice(0, 10), end_date: end.toISOString().slice(0, 10) });\n  }\n}\nreturn [{ json: { windows, ga4_configured: Boolean($env.GA4_PROPERTY_ID) } }];"
      },
