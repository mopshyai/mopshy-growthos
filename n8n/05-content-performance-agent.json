        "jsCode": "const get = (n) => { try { return $(n).all().map(i => i.json); } catch (e) { return null; } };\nconst plan = get('Explode Windows') || get('Explode Windows (No GA4)') || [];\nconst gsc = get('GSC Page Performance') || get('GSC Page Performance (No GA4)') || [];\nconst ga4S = get('GA4 Page Sessions') || [];\nconst ga4AI = get('GA4 AI Referrals') || [];\nconst snapshots = [];\nplan.forEach((p, i) => {\n  const r = (gsc[i] && gsc[i].rows && gsc[i].rows[0]) || {};\n  const impressions = Number(r.impressions || 0);\n  const clicks = Number(r.clicks || 0);\n  const snap = { draft_id: p.draft_id, window_days: p.window_days, impressions, clicks, ctr: impressions ? Number((clicks / impressions).toFixed(6)) : null, avg_position: r.position != null ? Number(r.position) : null, metadata: { url: p.url } };\n  const g = ga4S[i] && ga4S[i].rows && ga4S[i].rows[0];\n  if (g) {\n    snap.organic_sessions = Number((g.metricValues && g.metricValues[0] && g.metricValues[0].value) || 0);\n    snap.conversions = Number((g.metricValues && g.metricValues[1] && g.metricValues[1].value) || 0);\n  }\n  const ai = ga4AI[i] && ga4AI[i].rows;\n  if (ai && ai.length) {\n    let chatgpt = 0, other = 0;\n    for (const row of ai) {\n      const src = (row.dimensionValues && row.dimensionValues[0] && row.dimensionValues[0].value) || '';\n      const v = Number((row.metricValues && row.metricValues[0] && row.metricValues[0].value) || 0);\n      if (src.includes('chatgpt') || src.includes('openai')) chatgpt += v; else other += v;\n    }\n    snap.chatgpt_referrals = chatgpt;\n    snap.other_ai_referrals = other;\n  }\n  snapshots.push(snap);\n});\nreturn [{ json: { snapshots, snapshot_count: snapshots.length } }];"
      },
