      "parameters": {
        "jsCode": "// Recovery: a draft reserved as 'publishing' (by 04) that still has no PR URL\n// after 2 hours means the publisher died mid-flight. Raise a P1 task; do NOT\n// flip state automatically. Deduped against open stuck tasks.\nconst openTitles = new Set(items.map(i => i.json && i.json.title).filter(Boolean));\nconst stuck = $('Get Publishing Drafts').all().map(i => i.json)\n  .filter(d => d && d.id && !d.github_pr_url && (Date.now() - new Date(d.created_at || 0).getTime()) > 2 * 3600000\n               && !openTitles.has('Publishing stuck: ' + d.slug));\nreturn [{ json: { stuck, count: stuck.length } }];"
      },
