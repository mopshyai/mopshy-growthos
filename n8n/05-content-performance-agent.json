      "id": "get-pr-state",
      "name": "Get PR State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const plan = $('Split PR Numbers').all().map(i => i.json).filter(d => d.draft_id);\nconst resp = $('Get PR State').all().map(i => i.json);\nlet merged = 0, failed = 0, open = 0;\nplan.forEach((p, i) => {\n  const r = resp[i] || {};\n  if (r.merged === true) merged++;\n  else if (r.state === 'closed') failed++;\n  else open++;\n});\nreturn [{ json: { phase_a_summary: { publishing_drafts_checked: plan.length, prs_merged: merged, prs_closed_unmerged: failed, prs_still_open: open } } }];"
      },
      "id": "consolidate",
      "name": "Consolidate PRs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const plan = $('Split PR Numbers').all().map(i => i.json).filter(d => d.draft_id);\nconst resp = $('Get PR State').all().map(i => i.json);\nconst out = [];\nplan.forEach((p, i) => {\n  const r = resp[i] || {};\n  const merged = r.merged === true;\n  const closed = r.state === 'closed';\n  out.push({ draft_id: p.draft_id, slug: p.slug, opportunity_id: p.opportunity_id, outcome: merged ? 'merged' : (closed ? 'failed' : 'open'), pr_url: r.html_url || null });\n});\nreturn out.map(o => ({ json: o }));"
      },
      "id": "classify",
      "name": "Classify PR Outcomes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        -320
      ]
