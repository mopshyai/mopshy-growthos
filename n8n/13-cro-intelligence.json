    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst get = (n) => { try { return $(n).first().json; } catch (e) { return null; } };\nconst landing = get('GA4 Landing Report');\nif (!landing || !landing.rows) return [{ json: { summary: { skipped: 'GA4 not configured or no rows' }, tasks_created: 0 } }];\nconst rows = (landing.rows || []).map(r => ({ path: r.dimensionValues[0].value, sessions: Number(r.metricValues[0].value || 0), conversions: Number(r.metricValues[1].value || 0), bounce_rate: Number(r.metricValues[2].value || 0) }));\nconst weak = rows.filter(r => r.sessions >= 100).sort((a, b) => (a.conversions / a.sessions) - (b.conversions / b.sessions)).slice(0, 5);\nconst experiments = weak.map(r => ({ name: 'LP conversion test: ' + r.path, page_url: r.path, hypothesis: 'Page gets ' + r.sessions + ' sessions/28d but converts at ' + ((100 * r.conversions / r.sessions).toFixed(1)) + '% with ' + ((100 * r.bounce_rate).toFixed(0)) + '% bounce. A clearer offer and CTA above the fold should lift conversions.', control: 'current page', variant: 'rewritten hero: specific outcome, proof, single CTA', primary_metric: 'conversions', status: 'planned', result: {} }));\nconst tasks = weak.map(r => mk('cro_experiment_proposal', 'P2', 'CRO experiment: ' + r.path, 'Landing page converts at ' + ((100 * r.conversions / r.sessions).toFixed(1)) + '% across ' + r.sessions + ' sessions. Approve a hero/CTA test.', { path: r.path, sessions: r.sessions, conversions: r.conversions, expected_impact: 'conversion rate lift' }, true));\nconst deduped = dedupeTitles(tasks, $('Get Open CRO Tasks').all().map(i => i.json));\nconst dev = get('GA4 Device Report');\nreturn [{ json: { experiment_inserts: experiments, tasks: deduped, summary: { landing_pages_analyzed: rows.length, experiments_proposed: deduped.length, devices: dev && dev.rows ? dev.rows.map(r => r.dimensionValues[0].value + ':' + r.metricValues[0].value).join(', ') : null }, tasks_created: deduped.length } }];"
      },
