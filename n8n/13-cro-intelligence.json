        "jsCode": "// Idempotency: skip a planned experiment if one already exists (planned) for\n// the same landing page, so retries cannot stack duplicate experiments.\nconst planned = new Set(items.map(i => i.json && i.json.page_url).filter(Boolean));\nconst build = $('Build Run Summary').first().json;\nconst experiments = (build.experiment_inserts || []).filter(e => !planned.has(e.page_url));\nreturn [{ json: { experiment_inserts: experiments, tasks: build.tasks || [] } }];"
      },
