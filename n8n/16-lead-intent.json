    {
      "parameters": {
        "jsCode": "const mk = (task_type, priority, title, description, payload, approval) => ({ task_type, priority, title, description, confidence: 0.7, expected_impact: (payload && payload.expected_impact) || null, status: 'queued', requires_approval: !!approval, payload: payload || {} });\nconst dedupeTitles = (candidates, openItems) => { const open = new Set(openItems.map(t => t.title)); return candidates.filter(t => !open.has(t.title)); };\nconst get = (n) => { try { return $(n).first().json; } catch (e) { return null; } };\nconst resp = get('HubSpot Contacts');\nif (!resp || !resp.results) return [{ json: { summary: { skipped: 'HubSpot not configured or no contacts' }, tasks_created: 0 } }];\nconst existing = new Set($('Get Existing Leads').all().map(i => i.json && i.json.hubspot_contact_id).filter(Boolean));\nconst stageBase = { subscriber: 10, lead: 30, marketingqualifiedlead: 50, salesqualifiedlead: 70, opportunity: 90, customer: 60, other: 20, unqualified: 5 };\nconst now = Date.now();\nconst leads = [], tasks = [];\nfor (const ct of resp.results) {\n  if (existing.has(ct.id)) continue;\n  const p = ct.properties || {};\n  const stage = String(p.lifecyclestage || 'other').toLowerCase();\n  const mod = Date.parse(p.lastmodifieddate || '') || 0;\n  const ageH = (now - mod) / 3600000;\n  let score = (stageBase[stage] !== undefined ? stageBase[stage] : 20) + (ageH < 24 ? 10 : ageH < 168 ? 5 : 0) + (p.hs_lead_status === 'IN_PROGRESS' ? 5 : 0);\n  score = Math.min(99, score);\n  const name = [p.firstname, p.lastname].filter(Boolean).join(' ') || null;\n  leads.push({ hubspot_contact_id: ct.id, email: p.email || null, name, lifecycle_stage: stage, intent_score: score, source: 'hubspot', metadata: { scored_at: new Date().toISOString(), hs_lead_status: p.hs_lead_status || null } });\n  if (score >= 70) tasks.push(mk('lead_intent_hot', 'P1', 'Hot lead: ' + (p.email || ct.id), 'HubSpot contact scored ' + score + '/100 intent (stage ' + stage + ', last modified ' + Math.round(ageH) + 'h ago). Follow up in HubSpot.', { contact_id: ct.id, intent_score: score, expected_impact: 'pipeline' }, false));\n}\nconst deduped = dedupeTitles(tasks, $('Get Open Lead Tasks').all().map(i => i.json));\nreturn [{ json: { lead_inserts: leads, tasks: deduped.slice(0, 10), summary: { contacts_seen: resp.results.length, new_leads: leads.length, hot_leads: deduped.filter(t => t.priority === 'P1').length }, tasks_created: deduped.length } }];"
      },
