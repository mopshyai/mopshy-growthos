      "id": "2132e2c3-5d97-553f-99d3-5e6319bf5282",
      "name": "Get Existing Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        -240
      ],
      "alwaysOutputData": true
