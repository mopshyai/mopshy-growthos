{
  "name": "98 - Stale Run Watchdog",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "98-schedule",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1520,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "98-timeout",
              "name": "timeout_minutes",
              "value": "={{ Number($env.GROWTHOS_RUN_TIMEOUT_MINUTES || 45) }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "98-config",
      "name": "Run Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1280,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const minutes = Number($('Run Config').first().json.timeout_minutes) || 45;\nconst cutoff = new Date(Date.now() - minutes * 60000).toISOString();\nreturn [{ json: { cutoff, timeout_minutes: minutes } }];"
      },
      "id": "98-compute-cutoff",
      "name": "Compute Cutoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1040,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/agent_runs?status=eq.running&started_at=lt.' + $('Compute Cutoff').first().json.cutoff + '&select=id,agent_id,started_at&order=started_at.asc&limit=100' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        }
      },
      "id": "98-get-stale-runs",
      "name": "Get Stale Runs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -800,
        0
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Double-check age here too: the DB filter is authoritative, but this guards\n// against clock drift and guarantees a run that no longer exceeds the timeout\n// is never touched. A run marked failed leaves the running set, so it cannot\n// be reprocessed by a later watchdog pass (idempotent by construction).\nconst cutoff = $('Compute Cutoff').first().json.cutoff;\nconst timeoutMinutes = $('Compute Cutoff').first().json.timeout_minutes;\nconst runs = items.map(i => i.json).filter(r => r && r.id && r.started_at && new Date(r.started_at) < new Date(cutoff));\nconst byAgent = new Map();\nfor (const r of runs) {\n  const a = byAgent.get(r.agent_id) || { agent_id: r.agent_id, count: 0, oldest_started_at: r.started_at };\n  a.count += 1;\n  byAgent.set(r.agent_id, a);\n}\nreturn [{ json: { runs, by_agent: [...byAgent.values()], stale_count: runs.length, timeout_minutes: timeoutMinutes } }];"
      },
      "id": "98-normalize-stale-runs",
      "name": "Normalize Stale Runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.stale_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "98-has-stale-runs?",
      "name": "Has Stale Runs?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -320,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $json.runs.map(r => ({ json: r }));"
      },
      "id": "98-explode-stale-runs",
      "name": "Explode Stale Runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -160
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/agent_runs?id=eq.' + $json.id }}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ status: 'failed', completed_at: $now.toISO(), error: 'stalled: run exceeded GROWTHOS_RUN_TIMEOUT_MINUTES (' + $('Normalize Stale Runs').first().json.timeout_minutes + ' min); marked failed by 98-watchdog' }) }}"
      },
      "id": "98-mark-run-stalled",
      "name": "Mark Run Stalled",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        -160
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "return $json.by_agent.map(a => ({ json: a }));"
      },
      "id": "98-explode-agent-totals",
      "name": "Explode Agent Totals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        80
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Explode Agent Totals').item.json.agent_id ? ($env.SUPABASE_URL + '/rest/v1/agents?id=eq.' + $('Explode Agent Totals').item.json.agent_id + '&select=id,error_count') : ($env.SUPABASE_URL + '/rest/v1/agents?id=eq.00000000-0000-0000-0000-000000000000&select=id,error_count') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        }
      },
      "id": "98-get-agent-row",
      "name": "Get Agent Row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        80
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "url": "={{ $('Explode Agent Totals').item.json.agent_id ? ($env.SUPABASE_URL + '/rest/v1/agents?id=eq.' + $('Explode Agent Totals').item.json.agent_id) : ($env.SUPABASE_URL + '/rest/v1/agents?id=eq.00000000-0000-0000-0000-000000000000') }}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ error_count: (($('Get Agent Row').item.json && $('Get Agent Row').item.json.error_count) || 0) + $('Explode Agent Totals').item.json.count }) }}"
      },
      "id": "98-bump-agent-error-count",
      "name": "Bump Agent Error Count",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        80
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $('Normalize Stale Runs').first().json;\nreturn [{ json: {\n  event_type: 'stale_run_timeout',\n  severity: 'P1',\n  source: '98-stale-run-watchdog',\n  payload: {\n    stale_count: r.stale_count,\n    timeout_minutes: r.timeout_minutes,\n    agents: r.by_agent.map(a => ({ agent_id: a.agent_id, stale_runs: a.count, oldest_started_at: a.oldest_started_at })),\n    detected_at: new Date().toISOString()\n  }\n} }];"
      },
      "id": "98-compose-watchdog-event",
      "name": "Compose Watchdog Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        320
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/system_events' }}",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}"
      },
      "id": "98-log-watchdog-event",
      "name": "Log Watchdog Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        320
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tg-98",
              "name": "telegram_message",
              "value": "={{ '⏰ GrowthOS watchdog: ' + $('Normalize Stale Runs').first().json.stale_count + ' stale run(s) exceeded ' + $('Normalize Stale Runs').first().json.timeout_minutes + ' min and were marked failed. Agents: ' + $('Normalize Stale Runs').first().json.by_agent.map(a => (a.agent_id ? a.agent_id.slice(0, 8) : 'orphan') + ' x' + a.count).join(', ') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "98-prepare-alert",
      "name": "Prepare Telegram Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        400,
        320
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.telegram_message }}",
        "additionalFields": {}
      },
      "id": "98-send-alert",
      "name": "Send Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        640,
        320
      ],
      "webhookId": "growthos-98-alert",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {},
      "id": "98-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1760,
        40
      ]
    }
  ],
